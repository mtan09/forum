# Public browser/native client configuration only. Never put API keys here:
# EXPO_PUBLIC_* values are embedded in the app bundle.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=https://forumeveryside.com

# Mobile crash reporting. Keep the DSN in EAS/local environment configuration.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
