    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "@sentry/react-native",
        {
          "organization": "e1256f3339ad",
          "project": "forum"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you attach photos to posts and set your profile picture and banner.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/forumlogo.png",
